# Copy to .env. Generate different random passwords/keys before starting services.
APP_HOST=localhost
POSTGRES_PASSWORD=replace-with-random-password
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-password
DATABASE_URL=mysql+pymysql://mlops:replace-with-random-password@mysql/churn
FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_SECRET_KEY=replace-with-random-secret
AIRFLOW_ADMIN_PASSWORD=replace-with-random-password
API_KEY=replace-with-prediction-key
ADMIN_API_KEY=replace-with-different-admin-key
HPO_TRIALS=3
HPO_TIMEOUT=90
MIN_MODEL_AUC=0.55
MODEL_REFRESH_SECONDS=30
MODEL_NAME=ChurnModel
# Local Docker uses the persistent shared data volume. Azure uses private Blob Storage.
MLFLOW_ARTIFACT_ROOT=/app/data/mlartifacts
AZURE_STORAGE_ACCOUNT=
# Optional trusted, operator-managed sources. Never expose SQL or arbitrary URLs to API clients.
SOURCE_CSV=
SOURCE_API_URL=
SOURCE_DATABASE_URL=
SOURCE_SQL=
